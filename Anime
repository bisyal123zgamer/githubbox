    <script>
        // Enhanced Search Functionality
        class SearchManager {
            constructor() {
                this.searchInput = document.getElementById('searchInput');
                this.searchDropdown = document.getElementById('searchDropdown');
                this.filterPanel = document.getElementById('filterPanel');
                this.voiceSearchBtn = document.getElementById('voiceSearchBtn');
                this.filterBtn = document.getElementById('filterBtn');
                this.searchBtn = document.getElementById('searchBtn');
                this.searchHistory = [];
                this.isListening = false;
                
                this.initializeEvents();
                this.loadSearchHistory();
                this.updateSearchHistory();
                
                // Check for speech recognition support
                this.recognition = null;
                if ('webkitSpeechRecognition' in window || 'SpeechRecognition' in window) {
                    this.initVoiceSearch();
                }
            }
            
            initializeEvents() {
                // Search input events
                this.searchInput.addEventListener('focus', () => this.showDropdown());
                this.searchInput.addEventListener('input', (e) => this.handleSearch(e.target.value));
                this.searchInput.addEventListener('keypress', (e) => {
                    if (e.key === 'Enter') {
                        this.performSearch(e.target.value);
                    }
                });
                
                // Button events
                this.searchBtn.addEventListener('click', () => this.performSearch(this.searchInput.value));
                this.voiceSearchBtn.addEventListener('click', () => this.toggleVoiceSearch());
                this.filterBtn.addEventListener('click', () => this.toggleFilterPanel());
                
                // Filter panel events
                document.getElementById('applyFilters').addEventListener('click', () => this.applyFilters());
                document.getElementById('clearFilters').addEventListener('click', () => this.clearFilters());
                
                // Suggestion clicks
                document.addEventListener('click', (e) => {
                    if (e.target.closest('.search-suggestion')) {
                        const suggestion = e.target.closest('.search-suggestion');
                        const searchTerm = suggestion.getAttribute('data-search');
                        this.performSearch(searchTerm);
                    }
                    
                    // Close dropdowns when clicking outside
                    if (!e.target.closest('.search-container')) {
                        this.hideDropdown();
                        this.hideFilterPanel();
                    }
                });
            }
            
            initVoiceSearch() {
                const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
                this.recognition = new SpeechRecognition();
                this.recognition.continuous = false;
                this.recognition.interimResults = false;
                this.recognition.lang = 'en-US';
                
                this.recognition.onstart = () => {
                    this.isListening = true;
                    this.voiceSearchBtn.classList.add('recording');
                    this.voiceSearchBtn.innerHTML = '<i class="fas fa-stop"></i>';
                };
                
                this.recognition.onend = () => {
                    this.isListening = false;
                    this.voiceSearchBtn.classList.remove('recording');
                    this.voiceSearchBtn.innerHTML = '<i class="fas fa-microphone"></i>';
                };
                
                this.recognition.onresult = (event) => {
                    const transcript = event.results[0][0].transcript;
                    this.searchInput.value = transcript;
                    this.performSearch(transcript);
                };
                
                this.recognition.onerror = (event) => {
                    console.error('Speech recognition error:', event.error);
                    this.isListening = false;
                    this.voiceSearchBtn.classList.remove('recording');
                    this.voiceSearchBtn.innerHTML = '<i class="fas fa-microphone"></i>';
                };
            }
            
            toggleVoiceSearch() {
                if (!this.recognition) {
                    alert('Voice search is not supported in your browser');
                    return;
                }
                
                if (this.isListening) {
                    this.recognition.stop();
                } else {
                    this.recognition.start();
                }
            }
            
            showDropdown() {
                this.searchDropdown.classList.add('show');
                this.hideFilterPanel();
            }
            
            hideDropdown() {
                this.searchDropdown.classList.remove('show');
            }
            
            toggleFilterPanel() {
                this.filterPanel.classList.toggle('show');
                this.hideDropdown();
            }
            
            hideFilterPanel() {
                this.filterPanel.classList.remove('show');
            }
            
            handleSearch(query) {
                if (query.length === 0) {
                    this.showDropdown();
                    return;
                }
                
                // Real-time search filtering
                this.filterAnimeCards(query);
                
                if (query.length >= 2) {
                    // Show relevant suggestions based on query
                    this.updateSuggestions(query);
                }
            }
            
            performSearch(query) {
                if (!query.trim()) return;
                
                // Add to search history
                this.addToHistory(query);
                
                // Hide dropdowns
                this.hideDropdown();
                this.hideFilterPanel();
                
                // Show search results
                this.showSearchResults(query);
                
                // Filter content
                this.filterAnimeCards(query);
                
                // Update input
                this.searchInput.value = query;
            }
            
            filterAnimeCards(query) {
                const cards = document.querySelectorAll('.anime-card');
                const searchResults = document.getElementById('searchResults');
                const searchResultsText = document.getElementById('searchResultsText');
                let visibleCount = 0;
                
                cards.forEach(card => {
                    const title = card.getAttribute('data-title').toLowerCase();
                    const genre = card.getAttribute('data-genre').toLowerCase();
                    const searchTerm = query.toLowerCase();
                    
                    if (title.includes(searchTerm) || genre.includes(searchTerm) || searchTerm === '') {
                        card.style.display = 'block';
                        visibleCount++;
                    } else {
                        card.style.display = 'none';
                    }
                });
                
                // Show/hide search results info
                if (query.trim() && visibleCount > 0) {
                    searchResults.classList.remove('hidden');
                    searchResultsText.textContent = `Showing ${visibleCount} results for "${query}"`;
                } else if (query.trim() && visibleCount === 0) {
                    searchResults.classList.remove('hidden');
                    searchResultsText.textContent = `No results found for "${query}"`;
                } else {
                    searchResults.classList.add('hidden');
                }
            }
            
            updateSuggestions(query) {
                // This would typically connect to a real API
                // For demo purposes, we'll show static suggestions
                this.showDropdown();
            }
            
            showSearchResults(query) {
                const searchResults = document.getElementById('searchResults');
                const searchResultsText = document.getElementById('searchResultsText');
                searchResults.classList.remove('hidden');
                searchResultsText.textContent = `Search results for "${query}"`;
            }
            
            addToHistory(query) {
                // Remove if already exists
                this.searchHistory = this.searchHistory.filter(item => item !== query);
                // Add to beginning
                this.searchHistory.unshift(query);
                // Keep only last 10
                this.searchHistory = this.searchHistory.slice(0, 10);
                // Save to localStorage
                localStorage.setItem('streamvault_search_history', JSON.stringify(this.searchHistory));
                // Update display
                this.updateSearchHistory();
            }
            
            loadSearchHistory() {
                const stored = localStorage.getItem('streamvault_search_history');
                if (stored) {
                    this.searchHistory = JSON.parse(stored);
                }
            }
            
            updateSearchHistory() {
                const historyContainer = document.getElementById('searchHistory');
                historyContainer.innerHTML = '';
                
                this.searchHistory.forEach(item => {
                    const historyItem = document.createElement('div');
                    historyItem.className = 'history-item';
                    historyItem.innerHTML = `
                        <span class="history-text">${item}</span>
                        <button class="history-remove" data-query="${item}">
                            <i class="fas fa-times"></i>
                        </button>
                    `;
                    
                    // Add click events
                    historyItem.querySelector('.history-text').addEventListener('click', () => {
                        this.performSearch(item);
                    });
                    
                    historyItem.querySelector('.history-remove').addEventListener('click', (e) => {
                        e.stopPropagation();
                        this.removeFromHistory(item);
                    });
                    
                    historyContainer.appendChild(historyItem);
                });
            }
            
            removeFromHistory(query) {
                this.searchHistory = this.searchHistory.filter(item => item !== query);
                localStorage.setItem('streamvault_search_history', JSON.stringify(this.searchHistory));
                this.updateSearchHistory();
            }
            
            applyFilters() {
                const genre = document.getElementById('genreFilter').value;
                const yearFrom = document.getElementById('yearFrom').value;
                const yearTo = document.getElementById('yearTo').value;
                const rating = document.getElementById('ratingFilter').value;
                const episode = document.getElementById('episodeFilter').value;
                
                const cards = document.querySelectorAll('.anime-card');
                let visibleCount = 0;
                
                cards.forEach(card => {
                    let visible = true;
                    
                    // Genre filter
                    if (genre && !card.getAttribute('data-genre').includes(genre)) {
                        visible = false;
                    }
                    
                    // Year filter
                    const cardYear = parseInt(card.getAttribute('data-year'));
                    if (yearFrom && cardYear < parseInt(yearFrom)) {
                        visible = false;
                    }
                    if (yearTo && cardYear > parseInt(yearTo)) {
                        visible = false;
                    }
                    
                    // Rating filter
                    if (rating) {
                        const cardRating = parseFloat(card.getAttribute('data-rating'));
                        const minRating = parseFloat(rating.replace('+', ''));
                        if (cardRating < minRating) {
                            visible = false;
                        }
                    }
                    
                    card.style.display = visible ? 'block' : 'none';
                    if (visible) visibleCount++;
                });
                
                // Show results
                const searchResults = document.getElementById('searchResults');
                const searchResultsText = document.getElementById('searchResultsText');
                searchResults.classList.remove('hidden');
                searchResultsText.textContent = `Filtered results: ${visibleCount} anime found`;
                
                this.hideFilterPanel();
            }
            
            clearFilters() {
                // Reset all filter inputs
                document.getElementById('genreFilter').value = '';
                document.getElementById('yearFrom').value = '';
                document.getElementById('yearTo').value = '';
                document.getElementById('ratingFilter').value = '';
                document.getElementById('episodeFilter').value = '';
                
                // Clear checkboxes
                document.querySelectorAll('.filter-checkbox input[type="checkbox"]').forEach(cb => {
                    cb.checked = false;
                });
                
                // Show all cards
                document.querySelectorAll('.anime-card').forEach(card => {
                    card.style.display = 'block';
                });
                
                // Hide search results
                document.getElementById('searchResults').classList.add('hidden');
                
                // Clear search input
                this.searchInput.value = '';
                
                this.hideFilterPanel();
            }
        }
        
        // Initialize when DOM is loaded
        document.addEventListener('DOMContentLoaded', function() {
            // Initialize search manager
            const searchManager = new SearchManager();
            
            // Animate cards on scroll
            const cards = document.querySelectorAll('.anime-card');
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.style.opacity = '1';
                        entry.target.style.transform = 'translateY(0)';
                    }
                });
            }, { threshold: 0.1 });

            cards.forEach(card => {
                card.style.opacity = '0';
                card.style.transform = 'translateY(20px)';
                card.style.transition = 'opacity 0.6s ease, transform 0.6s ease';
                observer.observe(card);
            });

            // Category filtering
            const categoryBtns = document.querySelectorAll('.category-btn');
            categoryBtns.forEach(btn => {
                btn.addEventListener('click', function(e) {
                    e.preventDefault();
                    categoryBtns.forEach(b => b.classList.remove('active'));
                    this.classList.add('active');
                });
            });

            // Smooth scroll for better UX
            document.querySelectorAll('a[href^="#"]').forEach(anchor => {
                anchor.addEventListener('click', function (e) {
                    e.preventDefault();
                    const target = document.querySelector(this.getAttribute('href'));
                    if (target) {
                        target.scrollIntoView({
                            behavior: 'smooth'
                        });
                    }
                });
            });

            // Add click handlers for anime cards
            document.querySelectorAll('.anime-card').forEach(card => {
                card.addEventListener('click', function() {
                    const title = this.querySelector('h3').textContent;
                    alert(`Opening ${title}...`);
                    // Here you would typically navigate to the anime detail page
                });
            });
        });
    </script>
